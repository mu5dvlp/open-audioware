{
  // markdownlint-cli2(版は Makefile の MARKDOWNLINT_VERSION で固定)。
  //
  // 方針: 既定は全ルール OFF("default": false)にし、
  // 「読み手やエージェントが誤読する実害がある」と確かめたものだけを個別に ON にする。
  // 好みの問題(行長・空行の揃え・強調記号の揺れ 等)は入れない
  // ——ワークスペース(COMMON.md / scripts/docs-lint/)と同じ DevOps 方針。
  //
  // 2026-10-10 に対象範囲(COMMON.md / CLAUDE.md / AGENTS.md / docs/**/*.md / crates/**/*.md /
  // tools/**/*.md / scripts/**/*.md)に全ルールを当てて実測した件数と、違反の実物を見たうえでの
  // 判断を下に残す(README.md / CONTRIBUTING.md / CODE_OF_CONDUCT.md / SECURITY.md は
  // 人向けの文書として対象外 —— make docs-lint-readme-report で別枠)。
  "config": {
    "default": false,

    // --- 有効化したもの(実害を確認済み) ---

    // コードブロックに言語指定が無い(29件 → 修正)。ハイライトが効かず、
    // 人もエージェントも「これは何の言語か」を文脈だけで判断する必要が出る。
    "MD040": true,

    // 表の列数が見出し行と食い違う(2件 → 修正)。markdownlint 自身が
    // 「余ったセルのデータが消える」と指摘する通り、実際にレンダリング結果から
    // セルの中身が欠落する実害を確認した(1件は表の行が2物理行に割れていた本物の崩れ、
    // もう1件はコード区間内の `|drift|` の `|` を列区切りと誤認した誤検知 ——
    // 後者は docs/spec/overview.md 側にインライン disable コメントで対処した)。
    "MD056": true,

    // 以下の4つはリンクの書式が壊れているかどうかの検査。
    // 現状の違反は0件だが、壊れると「リンクのつもりの文字列がリンクにならない」
    // 「参照先が無いまま記法だけ残る」という実害に直結するため、将来の事故を防ぐ目的で有効化する
    // (0件なので有効化しても今回の docs を書き換える必要はない)。
    "MD042": true, // 空リンク [文字列]()
    "MD051": true, // 見出しアンカーの不一致(#見出し へのリンク切れ)
    "MD052": true, // 参照リンク・画像の参照先が未定義
    "MD053": true, // 使われていない参照定義(書式の崩れの早期警告)

    // --- 検討したが無効化したもの(好みの問題、または誤検知が確認できた) ---

    // MD013(行長・295件): 日本語の長い1文がそのまま1行になっている文書が大半で、
    // 行長で切る習慣が無い。好みの問題として無効(ワークスペースと同じ判断)。
    // MD012(連続空行・12件)/MD032(リスト前後の空行・11件)/MD022(見出し前後の空行・2件):
    // 読んで誤読する実害は薄く、直すと大量の機械的な空行の挿入・削除になる。好みの問題として無効。
    // MD001(heading-increment・7件): docs/history/ の日付ごとのエントリが意図的に
    // H2 直下を H4 で並べる書式(複数の日付を1ファイルに積む索引的な構成)。直すと
    // 見出しレベルの大量の書き換えになる割に、各ファイル内では一貫していて誤読の実害は薄い。
    // MD029(ol-prefix・6件): 番号付きリストの採番スタイル(1/1/1 と 1/2/3 の混在)。
    // レンダリング結果はどちらも自動で連番になり見た目は変わらないため、好みの問題として無効。
    // MD036(no-emphasis-as-heading・8件): 実物(docs/measurement-m1.md の計測メモ)は
    // 強調(**太字**)で注意書きを目立たせているだけで、見出しの代わりに使う意図は無い。
    // MD033(inline-html・3件): 実物は `<b>` によるインライン強調(docs/history.md の
    // 本文中の強調、docs/spec/overview.md の表セル内)で、意図的な使用。実害なし。
    // MD055(table-pipe-style・2件): docs/measurement-m1.md の1件は表の行が2物理行に
    // 割れていた本物の崩れだったため内容側を直した(1行に結合)。残る1件も同じ行の派生で
    // 解消済み。ルール自体は「表ごとに先頭/末尾の `|` の有無を統一しているか」という
    // 書式の好みの検査で、崩れていなければレンダリングに影響しないため無効のままにする。
    // MD025(single-title・2件): docs/history/12-2026-09-20.md が日付ごとのエントリ見出しを
    // H1 で区切る書式(他の history ファイルは H4 だが、この1ファイルだけ H1 を使っている)。
    // 過去の記録を書式統一のためだけに書き換える価値は薄いため無効。
    // MD038(no-space-in-code・2件): docs/history/06-2026-08-31.md の実際のエラーメッセージの
    // 引用で、引用元の文字列をそのまま再現しているだけ。件数も少なく実害は軽微。

    "MD013": false,
    "MD012": false,
    "MD032": false,
    "MD022": false,
    "MD001": false,
    "MD029": false,
    "MD036": false,
    "MD033": false,
    "MD055": false,
    "MD025": false,
    "MD038": false
  },

  "ignores": [
    "**/node_modules/**"
  ]
}
